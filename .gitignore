# ==========================================================
# FORTICO Madagascar — .gitignore racine
# ==========================================================

# ---------- Système / éditeurs ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json

# ---------- Secrets / variables d'environnement ----------
# Les fichiers .env contiennent des mots de passe et clés secrètes :
# ils ne doivent JAMAIS être versionnés.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------- Python / Django ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environnement virtuel (backend/.venv)
.venv/
venv/
env/
ENV/

# Caches Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Django
*.log
db.sqlite3
db.sqlite3-journal
backend/db.sqlite3
backend/media/
backend/staticfiles/
local_settings.py

# ---------- Node / React / Vite ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/stats.html
*.local

# Fichiers générés / temporaires
npm-debug.log*
yarn-error.log*
.DS_Store
tmp/
temp/
