# ==========================================================
# FORTICO Madagascar — Variables d'environnement du BACKEND
# ==========================================================
# Copiez ce fichier vers « backend/.env » puis adaptez les valeurs :
#     Windows (PowerShell) :  Copy-Item .env.example .env
#     Linux / macOS        :  cp .env.example .env
#
# ⚠️  Le fichier « .env » est IGNORÉ par Git : ne versionnez jamais
#     de vrai mot de passe ni de clé secrète.
# ==========================================================


# ---------- Django ----------
# Clé secrète utilisée pour signer les sessions et les jetons.
# Générez-en une avec :
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changez-moi-par-une-cle-secrete-longue-et-aleatoire

# Mode développement (True) ou production (False).
# En production, DOIT IMPERATIVEMENT être False.
DJANGO_DEBUG=True

# Hôtes autorisés à servir le site, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées à appeler l'API (CORS) — le frontend React en dev.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL publique du frontend (utilisée dans les liens des e-mails).
FRONTEND_URL=http://localhost:5173

# Domaine public officiel, à renseigner après validation par FORTICO.
# Sans cette valeur, le sitemap est désactivé et robots.txt ne le référence pas.
PUBLIC_SITE_URL=


# ---------- Base de données ----------
# With DB_ENGINE unset and no DB_* values, SQLite is selected.
# For PostgreSQL, use the example values below and replace the local password.

# Example values only. Replace DB_PASSWORD in the local .env; never use it for production.
DB_ENGINE=postgresql
DB_NAME=fortico_db
DB_USER=postgres
DB_PASSWORD=change-me-local-only
DB_HOST=127.0.0.1
DB_PORT=5432


# ---------- Sécurité ----------
# Durée de vie de la session Django (en minutes).
SESSION_COOKIE_AGE=1209600

# Activer les cookies "secure" (HTTPS obligatoire) — True en production.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Durée de vie du jeton d'authentification de l'API (en minutes).
API_TOKEN_LIFETIME=480
