# ==========================================================
# FORTICO Madagascar — Variables d'environnement du BACKEND
# ==========================================================
# Copiez ce fichier vers « backend/.env » puis adaptez les valeurs :
#     Windows (PowerShell) :  Copy-Item .env.example .env
#     Linux / macOS        :  cp .env.example .env
#
# ⚠️  Le fichier « .env » est IGNORÉ par Git : ne versionnez jamais
#     de vrai mot de passe ni de clé secrète.
# ==========================================================


# ---------- Django ----------
# Clé secrète utilisée pour signer les sessions et les jetons.
# Générez-en une avec :
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changez-moi-par-une-cle-secrete-longue-et-aleatoire

# Mode développement (True) ou production (False).
# En production, DOIT IMPERATIVEMENT être False.
DJANGO_DEBUG=True

# Hôtes autorisés à servir le site, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées à appeler l'API (CORS) — le frontend React en dev.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL publique du frontend (utilisée dans les liens des e-mails).
FRONTEND_URL=http://localhost:5173

# Domaine public officiel, à renseigner après validation par FORTICO.
# Sans cette valeur, le sitemap est désactivé et robots.txt ne le référence pas.
PUBLIC_SITE_URL=
# Laisser désactivé jusqu'à validation explicite du domaine et des contenus.
DJANGO_SEARCH_INDEXING_ENABLED=False


# ---------- Base de données ----------
# Render peut fournir une URL PostgreSQL complète. Si elle est définie,
# DATABASE_URL prend priorité sur tous les paramètres DB_* ci-dessous.
# Ne collez la vraie URL que dans l'environnement privé du service Render.
DATABASE_URL=
# Sans DATABASE_URL, les réglages PostgreSQL locaux ci-dessous restent utilisés.

# Example values only. Replace DB_PASSWORD in the local .env; never use it for production.
DB_ENGINE=postgresql
DB_NAME=fortico_db
DB_USER=postgres
DB_PASSWORD=change-me-local-only
DB_HOST=127.0.0.1
DB_PORT=5432
# Durée de connexion persistante (secondes). 0 ferme la connexion à la fin
# de chaque requête. N'augmenter qu'après dimensionnement workers/PostgreSQL.
DB_CONN_MAX_AGE=0
# Nombre de proxys fiables en fin de chaîne X-Forwarded-For. Laisser à 0
# sauf si le reverse proxy écrase/complète l'en-tête et que la topologie est connue.
DRF_NUM_PROXIES=0


# ---------- Sécurité ----------
# Durée de vie de la session Django (en minutes).
SESSION_COOKIE_AGE=1209600

# Activer les cookies "secure" (HTTPS obligatoire) — True en production.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Durée de vie du jeton d'authentification de l'API (en minutes).
API_TOKEN_LIFETIME=480

# ---------- E-mails (développement) ----------
# En production, sélectionner le backend SMTP et fournir les identifiants dans
# le gestionnaire de secrets de l'hébergeur, jamais dans Git.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@fortico.local
CONTACT_NOTIFICATION_EMAIL=

# ---------- Production : valeurs à renseigner après décisions FORTICO ----------
DJANGO_LOG_LEVEL=INFO
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS reste désactivé tant que domaine et sous-domaines HTTPS ne sont pas validés.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
