# ==========================================================
# FORTICO Madagascar — Variables d'environnement du FRONTEND
# ==========================================================
# Copiez ce fichier vers « frontend/.env » :
#     Copy-Item .env.example .env
#
# ⚠️  Le fichier « .env » est IGNORÉ par Git.
# ⚠️  Toute variable préfixée par VITE_ est EXPOSÉE dans le bundle
#     du navigateur : n'y placez jamais de secret.
# ==========================================================


# URL de l'API Django.
# En développement, laissez la valeur « /api » : le serveur Vite
# redirige automatiquement les appels vers le backend Django
# (voir le bloc « server.proxy » dans vite.config.js).
# En production, indiquez l'URL publique complète de l'API :
#     VITE_API_BASE_URL=https://api.fortico.mg/api
VITE_API_BASE_URL=/api

# Titre du site (balise <title> et nom de l'onglet).
VITE_SITE_NAME=FORTICO Madagascar

# Origine officielle du site, à renseigner après validation par FORTICO.
# Sert aux canoniques des pages de détail ; ne pas mettre de chemin ni de secret.
VITE_PUBLIC_SITE_URL=
